{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",

    "paths": {
      "@e2e/*": ["playwright/e2e/*"],
      "@ui/*": ["playwright/ui/*"],
      "@data/*": ["playwright/data/*"],
      "@services/*": ["playwright/services/*"],
      "@api-kit/*": ["playwright/api-kit/*"],
      "@core/*": ["playwright/core/*"],
      "@support/*": ["playwright/support/*"],
      "@config/*": ["playwright/config/*"],
      "@runs/*": ["playwright/runs/*"]
    }
  },
  "include": ["playwright/**/*.ts", "playwright.config.ts"]
}
